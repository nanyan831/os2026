+fail:
+    exit_mmap(mm);
+    put_pgdir(mm);
+    mm_destroy(mm);
+    return ret;
+}
+
+static void release_mm(struct proc_struct *proc)
+{
+    struct mm_struct *mm = proc->mm;
+    if (mm != NULL) {
+        if (proc == current) { lsatp(boot_pgdir_pa); flush_tlb(); }
+        proc->mm = NULL;
+        proc->pgdir = boot_pgdir_pa;
+        if (mm_count_dec(mm) == 0) {
+            exit_mmap(mm);
+            put_pgdir(mm);
+            mm_destroy(mm);
+        }
+    }
+}
