+// Challenge: only an originally writable VMA and an explicit COW leaf may split.
+int cow_resolve(struct mm_struct *mm, uintptr_t addr)
+{
+    if (mm == NULL || !user_mem_check(mm, addr, 1, 1)) return -E_INVAL;
+    bool intr_flag;
+    local_intr_save(intr_flag);
+    pte_t *pte = get_pte(mm->pgdir, addr, 0);
+    int ret = -E_INVAL;
+    if (pte != NULL && (*pte & (PTE_V | PTE_U | PTE_COW)) ==
+                               (PTE_V | PTE_U | PTE_COW) && !(*pte & PTE_W)) {
+        struct Page *old = pte2page(*pte);
+        uint32_t perm = ((*pte & 0x3ff) | PTE_W | PTE_R | PTE_D) & ~PTE_COW;
+        if (page_ref(old) == 1) {
+            *pte = pte_create(page2ppn(old), perm);
+            tlb_invalidate(mm->pgdir, addr);
