+// Return fully free, page-aligned portions of the SLOB arena to PMM.
+// The original skeleton retained them forever after fork bursts.
+void kmalloc_trim(void)
+{
+    bool irq;
+    local_intr_save(irq);
+    slob_t *prev = &arena, *cur = arena.next;
+    slobfree = &arena;
+    while (cur != &arena) {
+        uintptr_t start = ROUNDUP((uintptr_t)cur, PGSIZE);
+        uintptr_t end = ROUNDDOWN((uintptr_t)(cur + cur->units), PGSIZE);
+        if (start < end) {
+            slob_t *next = cur->next;
+            uintptr_t block_end = (uintptr_t)(cur + cur->units);
+            if (end < block_end) {
+                slob_t *tail = (slob_t *)end;
+                tail->units = (block_end - end) / SLOB_UNIT;
+                tail->next = next;
+                next = tail;
+            }
+            if (start > (uintptr_t)cur) {
+                cur->units = (start - (uintptr_t)cur) / SLOB_UNIT;
+                cur->next = next;
+                prev = cur;
+            } else prev->next = next;
+            free_pages(kva2page((void *)start), (end - start) / PGSIZE);
+            cur = next;
+        } else { prev = cur; cur = cur->next; }
+    }
+    local_intr_restore(irq);
+}
