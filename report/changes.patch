+//lab5 function3 2413807; Challenge: share original pages until first write.
+int copy_range(pde_t *to, pde_t *from, uintptr_t start, uintptr_t end, bool share)
+{
+    assert(start % PGSIZE == 0 && end % PGSIZE == 0 && USER_ACCESS(start, end));
+    for (; start < end; start += PGSIZE) {
+        pte_t *src = get_pte(from, start, 0);
+        if (src == NULL) { start = ROUNDUP(start + 1, PTSIZE) - PGSIZE; continue; }
+        if (!(*src & PTE_V)) continue;
+        struct Page *page = pte2page(*src);
+        uint32_t perm = *src & 0x3ff;
+        if (!share) {
+            struct Page *copy = alloc_page();
+            if (copy == NULL) return -E_NO_MEM;
+            memcpy(page2kva(copy), page2kva(page), PGSIZE);
+            if (perm & PTE_COW) perm = (perm | PTE_W) & ~PTE_COW;
+            int ret = page_insert(to, copy, start, perm);
+            if (ret != 0) { free_page(copy); return ret; }
+        } else {
+            // Allocate child PTE first; allocation failure leaves parent unchanged.
+            pte_t *dst = get_pte(to, start, 1);
+            if (dst == NULL) return -E_NO_MEM;
+            if (perm & PTE_W) perm = (perm & ~PTE_W) | PTE_COW;
+            int ret = page_insert(to, page, start, perm);
+            assert(ret == 0);
+            *src = pte_create(page2ppn(page), perm);
+            tlb_invalidate(from, start);
+        }
+    }
+    return 0;
+}
