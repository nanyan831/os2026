+    if (vma->vm_flags & VM_WRITE) perm |= PTE_W | PTE_R;
+    if (vma->vm_flags & VM_EXEC) perm |= PTE_X;
+    struct Page *page = pgdir_alloc_page(mm->pgdir, ROUNDDOWN(addr, PGSIZE), perm);
+    if (page == NULL) return -E_NO_MEM;
+    memset(page2kva(page), 0, PGSIZE);
+    return 0;
